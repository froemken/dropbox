{
	"name": "stefanfroemken/dropbox",
	"type": "typo3-cms-extension",
	"description": "Dropbox FAL Driver - Provides a Dropbox driver for TYPO3 File Abstraction Layer",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"typo3",
		"TYPO3 CMS",
		"dropbox",
		"fal",
		"driver"
	],
	"homepage": "https://www.typo3lexikon.de",
	"authors": [
		{
			"name": "Stefan Froemken",
			"email": "froemken@gmail.com",
			"role": "Lead Developer"
		}
	],
	"support": {
		"email": "froemken@gmail.com",
		"issues": "https://github.com/froemken/dropbox/issues",
		"source": "https://github.com/froemken/dropbox"
	},
	"require": {
		"php": "^8.2",
		"typo3/cms-core": "^14.3.0",
		"spatie/dropbox-api": "1.24.0"
	},
	"require-dev": {
		"ergebnis/composer-normalize": "^2.51",
		"typo3/coding-standards": "^0.8",
		"typo3/testing-framework": "^9.5"
	},
	"autoload": {
		"psr-4": {
			"StefanFroemken\\Dropbox\\": "Classes"
		}
	},
	"replace": {
		"typo3-ter/dropbox": "self.version"
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"Package": {
				"providesPackages": {
					"spatie/dropbox-api": "1.24.0"
				}
			},
			"app-dir": ".Build",
			"extension-key": "dropbox",
			"web-dir": ".Build/public"
		}
	}
}
